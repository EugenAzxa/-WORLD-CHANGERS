---
import '../styles/global.css';
import { SITE, stats } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const { title, description = SITE.tagline, image, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : new URL('/brand/wcsnewlogoPc.png', Astro.site).href;
const path = Astro.url.pathname;
const is = (p: string) => path === p || (p !== '/' && path.startsWith(p));

const NAV = [
  { label: 'About', items: [
    { href: '/our-mission/', label: 'Our Mission', sub: 'Why we exist' },
    { href: '/history/', label: 'History', sub: 'Since 2023' },
    { href: '/board-of-directors/', label: 'Board of Directors' },
    { href: '/our-team/', label: 'Our Team' },
    { href: '/about-us/', label: 'About the Summits' },
  ] },
  { label: 'Events', items: [
    { href: '/events-cat/', label: 'All Events', sub: `${stats.events} gatherings` },
    { href: '/upcoming-events/', label: 'Upcoming' },
    { href: '/completed-events/', label: 'Completed' },
    { href: '/locations/', label: 'Venues' },
    { href: '/spirit-of-quantum/', label: 'Spirit of Quantum 2027', sub: 'Patron programme' },
  ] },
  { label: 'Network', items: [
    { href: '/network-list/', label: 'The Network', sub: `${stats.people} members` },
    { href: '/speakers/', label: 'Speakers' },
    { href: '/guests/', label: 'Guests' },
    { href: '/awards/', label: 'Awards' },
  ] },
  { label: 'Media', items: [
    { href: '/category/press-release/', label: 'Press Releases' },
    { href: '/blog/', label: 'All Articles' },
    { href: '/gallery/', label: 'Gallery', sub: `${stats.photos.toLocaleString('en')} photographs` },
    { href: '/emotions-revealed/', label: 'Emotions Revealed' },
    { href: SITE.magazine, label: 'IASC Magazine ↗', ext: true },
    { href: SITE.catalogue, label: 'Catalogue 2025' },
  ] },
];
const ext = (it: any) => (it.ext ? { target: '_blank', rel: 'noopener' } : {});
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f5f2ec" />
    <link rel="icon" type="image/png" href="/brand/wcsnewlogo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" data-header>
      <div class="wrap">
        <a href="/" class="brand" aria-label="World Changers Summits — home">
          <img src="/brand/wcsnewlogoPc.png" alt="" width="55" height="42" />
          <span class="brand-name">World Changers<small>Summits · IASC</small></span>
        </a>
        <ul class="nav" role="list">
          {NAV.map((g, i) => (
            <li>
              <button class:list={['nav-link', { active: g.items.some((it) => !it.ext && is(it.href)) }]} aria-expanded="false" aria-controls={`dd-${i}`} data-dd>
                {g.label}
                <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.5 5 7l3.5-3.5" stroke="currentColor" stroke-width="1.4" fill="none" /></svg>
              </button>
              <div class="dropdown" id={`dd-${i}`}>
                {g.items.map((it) => <a href={it.href} {...ext(it)}>{it.label}{it.sub && <small>{it.sub}</small>}</a>)}
              </div>
            </li>
          ))}
          <li><a href="/world-map/" class:list={['nav-link map', { active: is('/world-map/') }]}>World Map</a></li>
          <li><a href="/contacts/" class:list={['nav-link', { active: is('/contacts/') }]}>Contact</a></li>
        </ul>
        <div class="header-actions">
          <button class="icon-btn" data-search-open aria-label="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          </button>
          <a href="/donate/" class="btn btn-primary btn-sm">Support</a>
          <button class="icon-btn menu-btn" data-menu-open aria-label="Open menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" /></svg>
          </button>
        </div>
      </div>
    </header>

    <div class="mobile-nav" data-menu aria-hidden="true">
      <div class="top">
        <a href="/" class="brand"><img src="/brand/wcsnewlogoPc.png" alt="World Changers" width="55" height="42" /><span class="brand-name">World Changers<small>Summits · IASC</small></span></a>
        <button class="icon-btn" data-menu-close aria-label="Close menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
      </div>
      <nav>
        <a href="/world-map/">World Map <span class="arr" aria-hidden="true">→</span></a>
        {NAV.map((g) => (
          <details>
            <summary>{g.label}</summary>
            <div>{g.items.map((it) => <a href={it.href} {...ext(it)}>{it.label}</a>)}</div>
          </details>
        ))}
        <a href="/contacts/">Contact <span class="arr" aria-hidden="true">→</span></a>
      </nav>
      <a href="/donate/" class="btn btn-primary">Support the mission</a>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <p class="footer-statement">Faith, science and art,<br /><em>in the service of humanity.</em></p>
          <div class="footer-grid">
            <div>
              <h4>Explore</h4>
              <ul role="list">
                <li><a href="/world-map/">World Map</a></li>
                <li><a href="/events-cat/">Events</a></li>
                <li><a href="/locations/">Venues</a></li>
                <li><a href="/gallery/">Gallery</a></li>
              </ul>
            </div>
            <div>
              <h4>Network</h4>
              <ul role="list">
                <li><a href="/network-list/">Members</a></li>
                <li><a href="/speakers/">Speakers</a></li>
                <li><a href="/awards/">Awards</a></li>
                <li><a href="/board-of-directors/">Board</a></li>
              </ul>
            </div>
            <div>
              <h4>Institute</h4>
              <ul role="list">
                <li><a href="/our-mission/">Mission</a></li>
                <li><a href="/history/">History</a></li>
                <li><a href="/yougiveuscourage/">You Give Us Courage</a></li>
                <li><a href="/category/press-release/">Press</a></li>
              </ul>
            </div>
            <div>
              <h4>Contact</h4>
              <ul role="list">
                <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
                <li><a href={SITE.orgUrl} target="_blank" rel="noopener">iascoop.org ↗</a></li>
                <li><a href={SITE.magazine} target="_blank" rel="noopener">IASC Magazine ↗</a></li>
                <li><a href="/donate/">Donate</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <div class="footer-logos">
            <img src="/brand/wcsnewlogoPc.png" alt="World Changers Summit" width="44" height="34" loading="lazy" />
            <a href={SITE.orgUrl} target="_blank" rel="noopener"><img src="/brand/logofullwhite.png" alt="Institute for Advance Studies and Cooperation" width="178" height="34" loading="lazy" /></a>
          </div>
          <span>© {new Date().getFullYear()} World Changers Summits · IASC · <a href="/terms-conditions/">Terms</a></span>
        </div>
      </div>
    </footer>

    <div class="search-modal" data-search role="dialog" aria-modal="true" aria-label="Search the site">
      <div class="search-box">
        <input class="field" type="search" placeholder="Search events, people, places…" data-search-input autocomplete="off" aria-label="Search" />
        <div class="search-results" data-search-results></div>
        <div class="search-hint"><span><kbd>↑</kbd> <kbd>↓</kbd> move</span><span><kbd>Enter</kbd> open</span><span><kbd>Esc</kbd> close</span></div>
      </div>
    </div>

    <div class="lightbox" data-lightbox-modal role="dialog" aria-modal="true" aria-label="Photo viewer">
      <img alt="" data-lb-img />
      <button class="lb-btn lb-close" data-lb-close aria-label="Close">×</button>
      <button class="lb-btn lb-prev" data-lb-prev aria-label="Previous photo">←</button>
      <button class="lb-btn lb-next" data-lb-next aria-label="Next photo">→</button>
      <div class="lb-count" data-lb-count></div>
    </div>

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
