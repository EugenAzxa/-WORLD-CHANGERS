---
import { globeData } from '../lib/globe-data';
interface Props { mode?: 'hero' | 'full' }
const { mode = 'hero' } = Astro.props;
const data = globeData();
const years = [...new Set(data.events.map((e: any) => e.start?.slice(0, 4)).filter(Boolean))].sort();
---
<div class:list={['globe', { full: mode === 'full' }]} data-globe data-mode={mode}>
  <div class="globe-stage">
    <canvas class="globe-earth" aria-hidden="true"></canvas>
    <canvas class="globe-ui" aria-label="Interactive globe of every World Changers gathering. The list of places next to it offers the same content for keyboard and screen-reader users." role="img"></canvas>
    <div class="globe-tooltip" aria-hidden="true"></div>
    <div class="globe-controls">
      <div class="globe-years" role="group" aria-label="Filter by year">
        <button type="button" class="tag" data-year="" aria-pressed="true">All</button>
        {years.map((y) => <button type="button" class="tag" data-year={y} aria-pressed="false">{y}</button>)}
      </div>
      <div class="globe-tools">
        <button type="button" class="icon-btn" data-zoom="in" aria-label="Zoom in">+</button>
        <button type="button" class="icon-btn" data-zoom="out" aria-label="Zoom out">−</button>
        <button type="button" class="icon-btn" data-reset aria-label="Reset view">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.6M4 4v4h4" /></svg>
        </button>
      </div>
    </div>
    <button type="button" class="btn btn-primary globe-play" data-play aria-pressed="false">
      <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5v11l9-5.5z" fill="currentColor" /></svg>
      <span>Play the journey</span>
    </button>
    <div class="globe-journey" aria-live="polite"></div>
    <p class="globe-legend"><i></i>Host city · size = number of gatherings<br />Outlined: host countries · Lines: from the Vatican<br />Earth imagery: NASA Blue Marble</p>
  </div>
  <aside class="globe-panel" aria-live="polite"></aside>
  <script type="application/json" set:html={JSON.stringify(data)} />
</div>
<script>
  import '../scripts/globe';
</script>
