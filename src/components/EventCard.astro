---
import { places } from '../lib/data';
const { e } = Astro.props as { e: any };
const place = e.place ? places[e.place] : null;
---
<a href={e.url} class="card ev-card" data-item data-year={e.year} data-status={e.status} data-place={e.place} data-theme={e.themes.join(' ')} data-search={`${e.title} ${e.venue || ''} ${place?.name || ''} ${place?.country || ''}`}>
  <div class="poster">
    {e.posterSm && <img src={e.posterSm} alt="" loading="lazy" />}
    {e.status === 'upcoming' && <span class="badge">Upcoming</span>}
  </div>
  <div class="card-body">
    <div class="date">{e.dateRange}</div>
    <h3>{e.title}</h3>
    {(e.venue || place) && (
      <div class="where">
        {place && <span class="code">{place.code}</span>}
        <span>{[place?.name, e.venue && e.venue !== place?.name ? e.venue : null].filter(Boolean).join(' — ')}</span>
      </div>
    )}
  </div>
</a>
