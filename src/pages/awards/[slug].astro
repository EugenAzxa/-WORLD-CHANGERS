---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import EventCard from '../../components/EventCard.astro';
import { awards, media, rewriteHtml, textOf } from '../../lib/data';
export function getStaticPaths() { return awards.map((a) => ({ params: { slug: a.slug }, props: { a } })); }
const { a } = Astro.props as { a: any };
---
<Layout title={`${a.name} — World Changers Award`} description={textOf(a.html).slice(0, 180)} image={media(a.image)}>
  <PageHero title={a.name} eyebrow="World Changers Award" crumbs={[{ href: '/awards/', label: 'Awards' }]} />
  <section class="section" style="padding-top:0">
    <div class="wrap two-col">
      <div>
        <div class="prose" set:html={rewriteHtml(a.html) || '<p>Award recipient.</p>'} />
        {a.person && <p style="margin-top:28px"><a class="btn btn-secondary" href={`/network/${a.person.slug}/`}>View {a.person.name}'s profile <span class="arr">→</span></a></p>}
      </div>
      {a.image && <a href={media(a.image)} data-lb="award" class="sticky-col"><img src={media(a.image)} alt={`${a.name} award`} style="border:1px solid var(--color-line)" /></a>}
    </div>
  </section>
  {a.events.length > 0 && (
    <section class="section bg-2"><div class="wrap">
      <div class="section-head"><p class="idx"><b>Presented at</b></p><div><h2 class="h2">The ceremony</h2></div></div>
      <div class="grid grid-3">{a.events.map((e: any) => <EventCard e={e} />)}</div>
    </div></section>
  )}
</Layout>
