---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import EventCard from '../../../components/EventCard.astro';
import { locations, places, media, rewriteHtml } from '../../../lib/data';
export function getStaticPaths() { return locations.map((l) => ({ params: { slug: l.slug }, props: { l } })); }
const { l } = Astro.props as { l: any };
const p = l.place ? places[l.place] : null;
const mapKey = l.place === 'rome' ? 'vatican' : l.place === 'st-moritz' ? 'davos' : l.place;
---
<Layout title={l.name} description={`${l.name}${p ? ', ' + p.name + ', ' + p.country : ''} — a World Changers venue.`} image={media(l.image)}>
  <PageHero title={l.name} eyebrow={p ? `${p.code} — ${p.name}, ${p.country}` : 'Venue'} lead={l.address || undefined} image={media(l.image)} crumbs={[{ href: '/locations/', label: 'Venues' }]}>
    {p && <div class="hero-actions"><a class="btn btn-primary" href={`/world-map/#place=${mapKey}`}>Show on the atlas <span class="arr">→</span></a></div>}
  </PageHero>
  <section class="section" style="padding-top:0">
    <div class="wrap two-col">
      <div class="prose" set:html={rewriteHtml(l.html) || '<p>Venue details coming soon.</p>'} />
      {l.image && <img src={media(l.image)} alt={l.name} class="sticky-col"  loading="lazy" />}
    </div>
  </section>
  {l.events.length > 0 && (
    <section class="section bg-2">
      <div class="wrap">
        <div class="section-head"><p class="idx"><b>Hosted here</b></p><div><h2 class="h2">Gatherings at {l.name}</h2></div></div>
        <div class="grid grid-3">{l.events.map((e: any) => <EventCard e={e} />)}</div>
      </div>
    </section>
  )}
</Layout>
