---
import Layout from '../../layouts/Layout.astro';
import Blocks from '../../components/Blocks.astro';
import EventCard from '../../components/EventCard.astro';
import { events, places, forms, THEMES, link } from '../../lib/data';

export function getStaticPaths() {
  return events.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props as { e: any };
const place = e.place ? places[e.place] : null;
const chrono = [...events].sort((a, b) => (a.start || '').localeCompare(b.start || ''));
const idx = chrono.indexOf(e);
const prev = chrono[idx - 1];
const nextEv = chrono[idx + 1];
const samePlace = place ? place.events.filter((x: any) => x !== e).slice(0, 3) : [];

const SECTION_LABELS: Record<string, string> = { gallery: 'Gallery', topics: 'Topics', speakers: 'Speakers', agenda: 'Agenda', partners: 'Partners', thanksto: 'Thanks to', awards: 'Awards', finalreport: 'Final report', team: 'Team', ambassadors: 'Ambassadors', guests: 'Guests' };
const sections = [...new Set(e.blocks.map((b: any) => b.section).filter(Boolean))] as string[];
const nav = sections.map((s) => ({ id: s, label: SECTION_LABELS[s] || s.replace(/[-_]/g, ' ').replace(/^\w/, (c) => c.toUpperCase()) }));

// Registration (forms live on the old WordPress site)
const words = e.slug.split('-').filter((w: string) => w.length > 3).slice(0, 3);
const form = e.status === 'upcoming' ? forms.find((f) => words.filter((w: string) => f.slug.includes(w)).length >= 2) : null;
---
<Layout title={e.title} description={e.description || `${e.title} — ${e.dateRange}${place ? ', ' + place.name : ''}`} image={e.posterFull}>
  <section class="ev-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/events-cat/">Events</a><span aria-hidden="true">/</span><a href={e.status === 'upcoming' ? '/upcoming-events/' : '/completed-events/'}>{e.status === 'upcoming' ? 'Upcoming' : 'Completed'}</a>
      </nav>
      <div class="ev-grid">
        <div>
          <div class="filters" style="margin:24px 0 28px">
            <span class:list={['tag', e.status === 'upcoming' ? 'tag-accent' : 'tag-strong']}>{e.status === 'upcoming' ? 'Upcoming' : 'Completed'}</span>
            {e.themes.map((t: string) => <a class="tag" href={`/events-cat/?theme=${t}`}>{THEMES[t].label}</a>)}
          </div>
          <h1 class="h1">{e.title}</h1>
          <dl class="info-list ev-facts">
            <div><dt>Date</dt><dd>{e.dateRange}{e.timeLabel && ` · ${e.timeLabel}`}</dd></div>
            {(e.venue || place) && (
              <div><dt>Place</dt><dd>
                {e.venueSlug ? <a class="link" href={`/events/locations/${e.venueSlug}/`}>{e.venue}</a> : e.venue}
                {place && <span class="muted">{e.venue ? ', ' : ''}{place.name} <span class="code">{place.code}</span></span>}
              </dd></div>
            )}
            {e.people.length > 0 && <div><dt>Network</dt><dd>{e.people.length} speakers and guests</dd></div>}
            {e.docs.length > 0 && <div><dt>Documents</dt><dd class="docs">{e.docs.map((d: any) => <a class="link" href={link(d.href)} target="_blank" rel="noopener">{d.label} (PDF)</a>)}</dd></div>}
          </dl>
          <div class="ev-actions">
            {form && <a class="btn btn-primary" href={form.url} target="_blank" rel="noopener">Register <span class="arr" aria-hidden="true">↗</span></a>}
            {e.gallery && <a class="btn btn-secondary" href={`/${e.gallery.slug}/`}>{e.gallery.images.length} photographs</a>}
            {place && <a class="btn btn-secondary" href={`/world-map/#place=${e.place === 'rome' ? 'vatican' : e.place === 'st-moritz' ? 'davos' : e.place}`}>Show on the atlas</a>}
          </div>
        </div>
        {e.posterFull && (
          <a class="ev-poster" href={e.posterFull} data-lb="poster" aria-label="Open poster">
            <img src={e.posterFull} alt={`${e.title} poster`} />
          </a>
        )}
      </div>
    </div>
  </section>

  {nav.length > 1 && (
    <nav class="pill-nav" aria-label="Sections">
      <div class="wrap">
        <a href="#overview">Overview</a>
        {nav.map((n) => <a href={`#${n.id}`}>{n.label}</a>)}
      </div>
    </nav>
  )}

  <section class="section" id="overview">
    <div class="wrap">
      {e.blocks.length ? <Blocks blocks={e.blocks} group={e.slug} galleryHref={e.gallery ? `/${e.gallery.slug}/` : undefined} /> : <p class="lead">{e.description}</p>}
      {e.status === 'upcoming' && (
        <p class="notice" style="margin-top:56px">Participation is strictly by invitation. To request an invitation, write to <a class="link" href="mailto:world@iascoop.org">world@iascoop.org</a>.</p>
      )}
    </div>
  </section>

  {samePlace.length > 0 && (
    <section class="section bg-2">
      <div class="wrap">
        <div class="section-head"><p class="idx"><b>{place.code}</b> — {place.name}</p><div><h2 class="h2">More gatherings here</h2></div></div>
        <div class="grid grid-3">{samePlace.map((x: any) => <EventCard e={x} />)}</div>
      </div>
    </section>
  )}

  <nav class="wrap ev-pager" aria-label="Chronological navigation">
    {prev ? <a href={prev.url}><span class="meta">← Earlier · {prev.dateRange}</span><b>{prev.title}</b></a> : <span></span>}
    {nextEv ? <a href={nextEv.url} class="right"><span class="meta">Later · {nextEv.dateRange} →</span><b>{nextEv.title}</b></a> : <span></span>}
  </nav>
</Layout>

<style>
  .ev-hero { padding: clamp(32px, 4vw, 56px) 0 clamp(48px, 6vw, 88px); }
  .ev-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .ev-facts { margin: 40px 0 0; }
  .ev-facts .docs { display: flex; flex-direction: column; gap: 4px; }
  .ev-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-6); }
  .ev-poster { display: block; border: 1px solid var(--color-line-strong); }
  .ev-pager { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--color-line-strong); margin-bottom: var(--space-9); }
  .ev-pager a { display: grid; gap: 8px; padding: var(--space-5) var(--space-5) var(--space-5) 0; }
  .ev-pager a.right { text-align: right; padding: var(--space-5) 0 var(--space-5) var(--space-5); border-left: 1px solid var(--color-line); }
  .ev-pager b { font: 400 var(--size-24)/1.2 var(--font-display); transition: color var(--dur-fast); }
  .ev-pager a:hover b { color: var(--color-accent); }
  @media (max-width: 860px) {
    .ev-grid { grid-template-columns: 1fr; }
    .ev-poster { max-width: 340px; order: -1; margin-top: 24px; }
    .ev-pager { grid-template-columns: 1fr; }
    .ev-pager a.right { text-align: left; border-left: 0; border-top: 1px solid var(--color-line); padding-left: 0; }
  }
</style>
