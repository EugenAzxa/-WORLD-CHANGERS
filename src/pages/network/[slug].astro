---
import Layout from '../../layouts/Layout.astro';
import EventCard from '../../components/EventCard.astro';
import PersonCard from '../../components/PersonCard.astro';
import { people, media, rewriteHtml, textOf } from '../../lib/data';
export function getStaticPaths() { return people.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props as { p: any };
const related = [...new Set(p.events.flatMap((e: any) => e.people))].filter((x: any) => x !== p && x.image).slice(0, 8);
const desc = textOf(p.bio).slice(0, 180) || `${p.name} — World Changers network.`;
const socialName = (u: string) => (u.match(/linkedin|instagram|facebook|twitter|x\.com|youtube/)?.[0] || 'Website').replace('x.com', 'X').replace(/^\w/, (c) => c.toUpperCase());
---
<Layout title={p.name} description={desc} image={media(p.image)}>
  <section class="pp-hero">
    <div class="wrap pp-grid">
      <div class="pp-photo">
        {p.image ? <img src={media(p.image)} alt={p.name} /> : <div class="pp-ph" aria-hidden="true">{p.name.split(' ').map((w: string) => w[0]).slice(0, 2).join('')}</div>}
      </div>
      <div>
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/network-list/">Network</a></nav>
        <div class="filters" style="margin:20px 0 24px">{[...p.roles].map((r: string) => <span class="tag tag-strong">{r}</span>)}</div>
        <h1 class="h1">{p.name}</h1>
        {p.headline && <p class="lead">{p.headline}</p>}
        {p.socials.length > 0 && <div class="filters" style="margin-top:20px">{p.socials.map((s: string) => <a class="tag" href={s} target="_blank" rel="noopener">{socialName(s)} ↗</a>)}</div>}
        {p.events.length > 0 && <p class="meta" style="margin-top:28px">Took part in {p.events.length} World Changers gathering{p.events.length > 1 ? 's' : ''}{p.awards.length ? ` · ${p.awards.length} award${p.awards.length > 1 ? 's' : ''}` : ''}</p>}
      </div>
    </div>
  </section>
  {p.bio && (
    <section class="section-tight"><div class="wrap"><div class="prose" set:html={rewriteHtml(p.bio)} /></div></section>
  )}
  {p.awards.length > 0 && (
    <section class="section-tight"><div class="wrap">
      <div class="section-head" style="margin-bottom:24px"><p class="idx"><b>Recognition</b></p><div></div></div>
      <div class="grid grid-2">{p.awards.map((a: any) => (
        <a class="card award-row" href={`/awards/${a.slug}/`}>
          {a.image && <img src={media(a.image, 's')} alt="" loading="lazy" />}
          <div><h3 class="h4">World Changers Award</h3><p class="muted" style="margin:6px 0 0;font-size:15px">{textOf(a.html).slice(0, 140)}…</p></div>
        </a>
      ))}</div>
    </div></section>
  )}
  {p.events.length > 0 && (
    <section class="section bg-2"><div class="wrap">
      <div class="section-head"><p class="idx"><b>Gatherings</b></p><div><h2 class="h2">On the World Changers stage</h2></div></div>
      <div class="grid grid-3">{p.events.map((e: any) => <EventCard e={e} />)}</div>
    </div></section>
  )}
  {related.length > 0 && (
    <section class="section"><div class="wrap">
      <div class="section-head"><p class="idx"><b>Related</b></p><div><h2 class="h2">Shared the stage with</h2><div class="head-actions"><a href="/network-list/" class="text-link">The full network <span class="arr">→</span></a></div></div></div>
      <div class="grid grid-4 people-grid">{related.map((x: any) => <PersonCard p={x} />)}</div>
    </div></section>
  )}
</Layout>
<style>
  .pp-hero { padding: clamp(32px, 4vw, 56px) 0 clamp(40px, 5vw, 72px); }
  .pp-grid { display: grid; grid-template-columns: 4fr 8fr; gap: clamp(28px, 6vw, 96px); align-items: end; }
  .pp-photo img, .pp-ph { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center 18%; background: var(--media-bg); filter: grayscale(1); }
  .pp-ph { display: grid; place-items: center; font: 400 80px/1 var(--font-display); color: var(--color-fg-muted); filter: none; }
  .award-row { display: grid; grid-template-columns: 140px 1fr; gap: var(--space-4); align-items: center; padding: var(--space-4) 0; border-bottom: 1px solid var(--color-line); }
  .award-row img { width: 140px; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (max-width: 760px) { .pp-grid { grid-template-columns: 1fr; } .pp-photo { max-width: 280px; } }
</style>
