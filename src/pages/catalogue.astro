---
// The IASC "Presentation 2025" catalogue, rebuilt as a native page-turning reader
// (replaces the WordPress 3D FlipBook). Pages are rendered by scripts/catalogue.py.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { events, SITE } from '../lib/data';
import cat from '../data/catalogue.json';

const total = cat.pages.length;
const ev = (slug: string) => events.find((e) => e.slug === slug);

type Ch = { from: number; to: number; title: string; kicker: string; slug?: string; note?: string };
const chapters: Ch[] = [
  { from: 1, to: 2, kicker: 'Cover', title: 'To help shape a better future' },
  { from: 3, to: 6, kicker: 'About & mission', title: 'Uniting visionaries for conscious evolution' },
  { from: 7, to: 8, kicker: 'Founder', title: 'Sir Prof. Dr. Gabriele Pao-Pei Andreoli', note: 'President of IASC · Founder & Director of the World Changers Summit' },
  { from: 9, to: 14, kicker: '1st edition', title: 'World Changers Summit 2023', slug: 'world-changers-summit-2023' },
  { from: 15, to: 20, kicker: '2nd edition', title: 'Power Women’s Summit 2023', slug: 'world-changer-power-womens-summit-2023' },
  { from: 21, to: 26, kicker: '3rd edition', title: 'World Changers Summit Dubai 2024', slug: 'world-changer-summit-dubai-2024' },
  { from: 27, to: 32, kicker: '4th edition', title: 'World Changers Summit 2024', slug: 'world-changers-summit-2024' },
  { from: 33, to: 38, kicker: '5th edition', title: 'Balkan Summit, Skopje 2024', slug: 'world-changers-summit-balkan-skopje-summit' },
  { from: 39, to: 44, kicker: '6th edition', title: 'Ethical & Innovation Summit 2024', slug: 'world-changers-ethical-innovation-summit' },
  { from: 45, to: 50, kicker: '7th edition', title: 'World Changers Davos 2025', slug: 'world-changers-davos-summit-2025' },
  { from: 51, to: 56, kicker: '8th edition', title: 'IASC and Elysian for a Better World', slug: 'iasc-and-elysian-for-a-better-world' },
  { from: 57, to: 60, kicker: 'Awards', title: 'Honoring those who change the world', note: 'Sri Sri Ravi Shankar · Cardinal Pietro Parolin · Fadil Berisha · Baba Mondi · Baldassare Reina · Olen Cesari' },
  { from: 61, to: 62, kicker: 'New events', title: 'A journey of impact, legacy and purpose' },
  { from: 63, to: 64, kicker: 'St. Moritz', title: 'St. Moritz Longevity Forum', slug: 'world-changers-st-moritz-longevity-forum' },
  { from: 65, to: 66, kicker: 'New York', title: 'World Changers Climate — Explore, Innovate, Flourish', note: 'Explorers Club · 25 September 2025' },
  { from: 67, to: 68, kicker: 'Rome / Vatican City', title: 'Transcend — Unveiling the Future of Humanity', slug: 'world-changers-vatican-city-trascendence-unviling-the-future-of-humanity' },
  { from: 69, to: 70, kicker: 'Uganda', title: 'WCS Africa, Kampala', note: 'Announced for 20 November 2026' },
  { from: 71, to: 72, kicker: 'Riyadh', title: 'WCS Tech for Peace — Ethical Energy Innovation', note: 'Announced for 2026' },
  { from: 73, to: 74, kicker: 'Porto Palermo', title: 'World Changers Balkans 2026', slug: 'porto-palermo-festival' },
  { from: 75, to: 78, kicker: 'Join the movement', title: 'Shape the future — partners & contacts' },
].map((c) => {
  const e = c.slug ? ev(c.slug) : undefined;
  return { ...c, url: e?.url, date: e?.dateRange };
});

const pdfUrl = 'https://wcsiasc.org/wp-content/uploads/2025/06/Presentation2025GP.pdf';
const textOf = (c: Ch) => cat.pages.slice(c.from - 1, c.to).map((p) => p.text).filter(Boolean);
---
<Layout title="Catalogue 2025" description="The World Changers Summit presentation 2025 — every edition from the Vatican to Davos, the awards and the new chapters, in a page-turning reader." image="/catalogue/pages/p01.webp">
  <PageHero title="The 2025 catalogue" eyebrow="Presentation 2025" lead="Seventy-eight pages on how the World Changers Summit began at the Pontifical Academy of Sciences, every edition since, the people it honours and where it goes next." crumbs={[{ href: '/catalogue/', label: 'Catalogue' }]} />

  <section class="section-tight reader-sec" id="reader">
    <div class="wrap">
      <div class="book-shell" data-book data-total={total}>
        <div class="book-bar">
          <p class="meta" aria-live="polite"><span data-book-label>Cover</span> <span class="muted">/ {total}</span></p>
          <div class="book-tools">
            <button type="button" class="book-tool" data-book-grid aria-expanded="false" aria-controls="book-grid">All pages</button>
            <button type="button" class="book-tool" data-book-fs aria-label="Full screen">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 5V1h4M11 1h4v4M15 11v4h-4M5 15H1v-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
            </button>
          </div>
        </div>

        <div class="book-stage">
          <button type="button" class="book-nav prev" data-book-prev aria-label="Previous page">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
          <div class="book" data-book-view style={`--ratio:${cat.width}/${cat.height}`}>
            <div class="leaf-slot left" data-slot="l"></div>
            <div class="leaf-slot right" data-slot="r"></div>
            <div class="spine" aria-hidden="true"></div>
          </div>
          <button type="button" class="book-nav next" data-book-next aria-label="Next page">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
        </div>

        <div class="book-scrub">
          <label class="sr-only" for="book-range">Go to page</label>
          <input id="book-range" type="range" min="1" max={total} value="1" data-book-range />
          <div class="book-hint meta muted">← → keys · swipe · click a page edge</div>
        </div>

        <div class="book-grid" id="book-grid" hidden data-book-gridview>
          {cat.pages.map((p) => (
            <button type="button" data-goto={p.n} aria-label={`Page ${p.n}`}>
              <img src={`/catalogue/pages/p${String(p.n).padStart(2, '0')}-sm.webp`} alt="" loading="lazy" width="240" height="339" />
              <span>{p.n}</span>
            </button>
          ))}
        </div>
      </div>
      <noscript><p class="notice">The page-turning reader needs JavaScript. You can <a class="link" href={pdfUrl}>open the PDF</a> (83 MB) instead.</p></noscript>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="idx"><b>Contents</b></p>
        <div>
          <h2 class="h2">Inside the catalogue</h2>
          <p class="lead">Eight editions in two years — and the next chapters across four continents.</p>
          <div class="head-actions">
            <a class="text-link" href={pdfUrl} rel="noopener">Original PDF, 83 MB <span class="arr">↗</span></a>
          </div>
        </div>
      </div>
      <ol class="rows toc">
        {chapters.map((c) => (
          <li class="row">
            <a class="meta toc-pages" href={`#p=${c.from}`} data-goto={c.from}>p. {c.from}{c.to > c.from ? `–${c.to}` : ''}</a>
            <div>
              <p class="meta muted">{c.kicker}</p>
              <a class="row-title" href={`#p=${c.from}`} data-goto={c.from}>{c.title}</a>
              {c.note && <p class="toc-note">{c.note}</p>}
            </div>
            <div class="row-aside">
              {c.date && <span class="meta">{c.date}</span>}
              {c.url && <a class="text-link" href={c.url}>Event page <span class="arr">→</span></a>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bg-2">
    <div class="wrap wrap-narrow">
      <div class="section-head" style="grid-template-columns:1fr"><div><p class="idx"><b>Text version</b></p><h2 class="h2">Read it as text</h2><p class="lead">The full text of every chapter, for screen readers, translation and search.</p></div></div>
      {chapters.map((c) => (
        <details class="cat-text">
          <summary><span class="meta">p. {c.from}–{c.to}</span><span>{c.kicker} — {c.title}</span></summary>
          <div class="prose">{textOf(c).map((t) => <p>{t}</p>)}</div>
        </details>
      ))}
    </div>
  </section>
</Layout>

<style is:global>
  .reader-sec { padding-top: 0; }
  .book-shell { border-top: 1px solid var(--color-line-strong); background: var(--color-bg-alt); }
  .book-shell:fullscreen { display: flex; flex-direction: column; justify-content: center; padding: 16px; overflow: auto; }
  .book-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 16px; border-bottom: 1px solid var(--color-line); }
  .book-tools { display: flex; gap: 8px; }
  .book-tool { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 40px; min-width: 40px; padding: 0 12px; border: 1px solid var(--color-line); font: 500 var(--size-12)/1 var(--font-meta); letter-spacing: 0.08em; text-transform: uppercase; background: var(--color-bg); }
  .book-tool:hover, .book-tool[aria-expanded='true'] { border-color: var(--color-fg); }
  .book-tool svg { width: 16px; height: 16px; }

  .book-stage { position: relative; display: grid; grid-template-columns: 56px 1fr 56px; align-items: center; padding: clamp(16px, 3vw, 40px) 0; }
  .book { position: relative; display: grid; grid-template-columns: 1fr 1fr; width: min(100%, calc((100vh - 260px) * 2 * var(--ratio))); margin: 0 auto; aspect-ratio: calc(2 * var(--ratio)); perspective: 2600px; }
  .book-shell:fullscreen .book { width: min(100%, calc((100vh - 150px) * 2 * var(--ratio))); }
  .leaf-slot { position: relative; background: var(--color-surface); box-shadow: 0 1px 0 var(--color-line); }
  .leaf-slot img, .leaf img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .leaf-slot.empty { background: transparent; box-shadow: none; }
  .spine { position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: var(--color-line); pointer-events: none; }
  .book.single { grid-template-columns: 1fr; aspect-ratio: var(--ratio); width: min(100%, calc((100vh - 260px) * var(--ratio))); }
  .book.single .spine, .book.single .leaf-slot.left { display: none; }
  /* the turning sheet */
  .leaf { position: absolute; top: 0; bottom: 0; width: 50%; transform-style: preserve-3d; z-index: 3; transition: transform 700ms cubic-bezier(0.45, 0.05, 0.25, 1); }
  .leaf.fwd { left: 50%; transform-origin: left center; }
  .leaf.back { left: 0; transform-origin: right center; }
  .leaf .face { position: absolute; inset: 0; backface-visibility: hidden; background: var(--color-surface); overflow: hidden; }
  .leaf .face.b { transform: rotateY(180deg); }
  .leaf .face::after { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 700ms; background: linear-gradient(to right, rgba(0,0,0,0.18), transparent 40%); }
  .leaf.turning .face::after { opacity: 1; }
  .leaf.fwd.turning { transform: rotateY(-180deg); }
  .leaf.back.turning { transform: rotateY(180deg); }

  .book-nav { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid var(--color-line); background: var(--color-bg); justify-self: center; }
  .book-nav:hover:not(:disabled) { border-color: var(--color-fg); }
  .book-nav:disabled { opacity: 0.35; cursor: default; }
  .book-nav svg { width: 20px; height: 20px; }

  .book-scrub { display: flex; align-items: center; gap: 24px; padding: 0 16px 16px; }
  .book-scrub input { flex: 1; accent-color: var(--color-accent); min-height: 44px; }
  .book-hint { white-space: nowrap; }

  .book-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 12px; padding: 16px; border-top: 1px solid var(--color-line); max-height: 60vh; overflow: auto; }
  .book-grid button { display: grid; gap: 6px; text-align: left; }
  .book-grid img { width: 100%; height: auto; aspect-ratio: 240/339; object-fit: cover; outline: 1px solid var(--color-line); background: var(--color-surface); }
  .book-grid button.on img, .book-grid button:hover img { outline: 2px solid var(--color-accent); }
  .book-grid span { font: 500 11px/1 var(--font-meta); color: var(--color-fg-muted); }

  .toc .row { grid-template-columns: 2fr 7fr 3fr; }
  .toc-pages { color: var(--color-fg-muted); }
  .toc-pages:hover { color: var(--color-accent); }
  .toc .row-title { display: inline-block; margin-top: 6px; }
  .toc .row-title:hover { color: var(--color-accent); }
  .toc-note { margin: 8px 0 0; color: var(--color-fg-soft); font-size: var(--size-15); }
  .toc .row-aside { display: grid; gap: 8px; justify-items: end; }

  .cat-text { border-top: 1px solid var(--color-line); }
  .cat-text:last-child { border-bottom: 1px solid var(--color-line); }
  .cat-text summary { display: grid; grid-template-columns: 110px 1fr; gap: 16px; align-items: baseline; padding: 16px 0; cursor: pointer; list-style: none; font: 400 var(--size-20)/1.3 var(--font-display); }
  .cat-text summary::-webkit-details-marker { display: none; }
  .cat-text summary:hover { color: var(--color-accent); }
  .cat-text .prose { padding: 0 0 24px 126px; }

  @media (max-width: 800px) {
    .book-stage { grid-template-columns: 1fr; padding: 16px 0 8px; }
    .book-nav { position: absolute; bottom: -52px; z-index: 4; }
    .book-nav.prev { left: 16px; } .book-nav.next { right: 16px; }
    .book-scrub { padding: 8px 72px 16px; }
    .book-hint { display: none; }
    .toc .row { grid-template-columns: 1fr; gap: 6px; }
    .toc .row-aside { justify-items: start; text-align: left; }
    .cat-text summary { grid-template-columns: 1fr; gap: 4px; }
    .cat-text .prose { padding-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .leaf { transition: none; } }
</style>

<script>
  import { mountBook } from '../scripts/book';
  mountBook();
</script>
