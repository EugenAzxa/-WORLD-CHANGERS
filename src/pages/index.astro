---
import Layout from '../layouts/Layout.astro';
import Globe from '../components/Globe.astro';
import Intro from '../components/Intro.astro';
import WelcomeFilm from '../components/WelcomeFilm.astro';
import EventCard from '../components/EventCard.astro';
import PersonCard from '../components/PersonCard.astro';
import { SITE, stats, events, upcoming, completed, people, posts, pages, galleries, places, THEMES, media, rewriteHtml, fmtDate, CATEGORY_NAMES } from '../lib/data';

const next = upcoming[0];
const nextPlace = next?.place ? places[next.place] : null;
const home = pages.home;
const letter = home.blocks.find((b: any) => b.type === 'heading' && b.body)?.body;
const testimonials = home.blocks.find((b: any) => b.type === 'testimonials')?.items || [];
const recent = completed.slice(0, 6);
const faces = people.filter((p) => p.image && p.roles.has('Speaker') && p.events.length).slice(0, 10);
const latestPosts = posts.slice(0, 5);
const themeRows = Object.entries(THEMES)
  .map(([k, t]) => { const evs = events.filter((e) => e.themes.includes(k)); return { k, label: t.label, n: evs.length, cities: [...new Set(evs.map((e) => e.place && places[e.place].name).filter(Boolean))] }; })
  .filter((t) => t.n)
  .sort((a, b) => b.n - a.n);
const mosaic = galleries.flatMap((g) => g.images.slice(3, 4).map((im: any) => ({ ...im, g }))).slice(0, 9);
const stat = [
  { n: stats.events, l: 'Gatherings' },
  { n: stats.countries, l: 'Countries' },
  { n: stats.cities, l: 'Host cities' },
  { n: stats.people, l: 'Network members' },
  { n: stats.awards, l: 'Awards given' },
  { n: stats.photos, l: 'Photographs' },
];
const idx = (n: number, label: string) => `<b>${String(n).padStart(2, '0')}</b> — ${label}`;
---
<Layout>
  <Intro />
  <WelcomeFilm />
  <!-- HERO -->
  <section class="hero" id="hero">
    <div class="wrap">
      <dl class="hero-meta">
        <div><dt>Founded</dt><dd>Pontifical Academy of Sciences, Vatican City, 2023</dd></div>
        <div><dt>Reach</dt><dd>{stats.events} gatherings in {stats.countries} countries</dd></div>
        <div><dt>Access</dt><dd>By invitation only</dd></div>
        {next && <div><dt>Next</dt><dd><a class="link" href={next.url}>{next.title}, {fmtDate(next.start, { short: true })}</a></dd></div>}
      </dl>
      <h1 class="display hero-title reveal">Uniting visionary minds to shape the <em>future</em> of our world.</h1>
      <div class="hero-sub">
        <p class="eyebrow">World Changers Summits<br />by the Institute for Advance<br />Studies and Cooperation</p>
        <div>
          <p class="lead">An international network of scientists, faith leaders, entrepreneurs and artists, meeting in the Vatican and around the world to advance ethical and social innovation.</p>
          <div class="hero-actions">
            <a href="#atlas" class="btn btn-primary">Explore the atlas <span class="arr" aria-hidden="true">↓</span></a>
            <a href="/events-cat/" class="btn btn-secondary">All gatherings</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 ATLAS -->
  <section class="section" id="atlas" style="padding-bottom:0">
    <div class="wrap">
      <div class="section-head">
        <p class="idx" set:html={idx(1, 'Atlas')} />
        <div>
          <h2 class="h2">Where the conversation has travelled</h2>
          <p class="lead">From the Casina Pio IV in the Vatican Gardens to Davos, Dubai, Riyadh, Tirana and Washington. Turn the globe, open a city, or play every gathering in order.</p>
          <div class="head-actions"><a class="text-link" href="/?intro=1">Watch the journey from 2023 <span class="arr" aria-hidden="true">↺</span></a></div>
        </div>
      </div>
    </div>
    <Globe mode="hero" />
    <div class="wrap">
      <div class="stats" style="border-top:0">
        {stat.map((s) => <div class="stat"><b data-count={s.n}>{s.n.toLocaleString('en')}</b><span>{s.l}</span></div>)}
      </div>
    </div>
  </section>

  <!-- 02 NEXT -->
  {next && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="idx" set:html={idx(2, 'Next gathering')} />
          <div><h2 class="h2">{next.title}</h2></div>
        </div>
        <div class="next">
          <a href={next.url} class="next-poster"><img src={next.posterFull} alt={`${next.title} poster`} loading="lazy" /></a>
          <div>
            <dl class="info-list">
              <div><dt>Date</dt><dd>{next.dateRange}{next.timeLabel && ` · ${next.timeLabel}`}</dd></div>
              <div><dt>Place</dt><dd>{next.venue}{nextPlace && nextPlace.name !== next.venue ? `, ${nextPlace.name}` : ''}</dd></div>
              <div><dt>Access</dt><dd>By invitation · <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
            </dl>
            {next.description && <p class="lead" style="margin-top:32px">{next.description}</p>}
            <div class="countdown" data-countdown={next.start} style="margin-top:32px" aria-label="Time until the event">
              <div><b data-cd="d">–</b><small>Days</small></div>
              <div><b data-cd="h">–</b><small>Hours</small></div>
              <div><b data-cd="m">–</b><small>Min</small></div>
              <div><b data-cd="s">–</b><small>Sec</small></div>
            </div>
            <div class="hero-actions">
              <a href={next.url} class="btn btn-primary">Read about the event <span class="arr" aria-hidden="true">→</span></a>
              <a href="/spirit-of-quantum/" class="btn btn-secondary">Patron programme</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 03 LETTER -->
  {letter && (
    <section class="section bg-2">
      <div class="wrap">
        <div class="section-head">
          <p class="idx" set:html={idx(3, 'A letter from the founder')} />
          <div><h2 class="h2">“Do more than observe; become an active participant.”</h2></div>
        </div>
        <div class="letter">
          <figure class="letter-photo">
            <img src={media('https://wcsiasc.org/wp-content/uploads/2023/08/gabround.png')} alt="Prof. Gabriele Pao-Pei Andreoli" width="312" height="312" loading="lazy" />
            <figcaption>
              <span class="h4">Prof. Gabriele Pao-Pei Andreoli, MD</span>
              <span class="meta" style="margin-top:6px">Founder &amp; Director</span>
              <a class="text-link" style="margin-top:16px" href="/network/gabriele-pao-pei-andreoli/">Profile <span class="arr" aria-hidden="true">→</span></a>
            </figcaption>
          </figure>
          <div class="prose serif dropcap" set:html={rewriteHtml(letter)} />
        </div>
      </div>
    </section>
  )}

  <!-- 04 THEMES -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="idx" set:html={idx(4, 'Subjects')} />
        <div>
          <h2 class="h2">Faith, science and art, around the questions of our time</h2>
          <div class="head-actions"><a class="text-link" href="/our-mission/">Our mission <span class="arr" aria-hidden="true">→</span></a></div>
        </div>
      </div>
      <div class="rows">
        {themeRows.map((t, i) => (
          <a class="row theme-row" href={`/events-cat/?theme=${t.k}`}>
            <span class="meta">{String(i + 1).padStart(2, '0')} / {t.n} gathering{t.n === 1 ? '' : 's'}</span>
            <span class="row-title">{t.label}</span>
            <span class="row-aside">{t.cities.slice(0, 3).join(', ')}{t.cities.length > 3 ? ` +${t.cities.length - 3}` : ''}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 RECENT -->
  <section class="section bg-2">
    <div class="wrap">
      <div class="section-head">
        <p class="idx" set:html={idx(5, 'Recent gatherings')} />
        <div>
          <h2 class="h2">The latest chapters</h2>
          <div class="head-actions"><a class="text-link" href="/events-cat/">All {stats.events} events <span class="arr" aria-hidden="true">→</span></a></div>
        </div>
      </div>
      <div class="grid grid-3">{recent.map((e) => <EventCard e={e} />)}</div>
    </div>
  </section>

  <!-- 06 NETWORK -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="idx" set:html={idx(6, 'Network')} />
        <div>
          <h2 class="h2">{stats.people} people have shared the stage</h2>
          <p class="lead">Cardinals and spiritual leaders, scientists, founders, diplomats, artists and physicians.</p>
          <div class="head-actions"><a class="text-link" href="/network-list/">The full network <span class="arr" aria-hidden="true">→</span></a></div>
        </div>
      </div>
      <div class="grid grid-4 people-grid">{faces.map((p) => <PersonCard p={p} />)}</div>
    </div>
  </section>

  <!-- 07 VOICES -->
  {testimonials.length > 0 && (
    <section class="section bg-2">
      <div class="wrap">
        <div class="section-head">
          <p class="idx" set:html={idx(7, 'Voices')} />
          <div><h2 class="h2">What participants say</h2></div>
        </div>
        <div class="grid grid-3">
          {testimonials.map((q: any) => <figure class="quote"><blockquote>“{q.quote}”</blockquote><figcaption>{q.author}</figcaption></figure>)}
        </div>
      </div>
    </section>
  )}

  <!-- 08 PRESS -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="idx" set:html={idx(8, 'Press')} />
        <div>
          <h2 class="h2">News and releases</h2>
          <div class="head-actions"><a class="text-link" href="/blog/">All {stats.press} articles <span class="arr" aria-hidden="true">→</span></a></div>
        </div>
      </div>
      <div class="rows">
        {latestPosts.map((p) => (
          <a class="row" href={p.url}>
            <span class="meta">{fmtDate(p.date, { short: true })}</span>
            <span class="row-title" style="font-size:var(--size-24)">{p.title}</span>
            <span class="row-aside meta">{p.categories.map((c: string) => CATEGORY_NAMES[c] || c).join(', ')}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 09 ARCHIVE -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <p class="idx" set:html={idx(9, 'Archive')} />
        <div>
          <h2 class="h2">{stats.photos.toLocaleString('en')} photographs from {galleries.length} gatherings</h2>
          <div class="head-actions"><a class="text-link" href="/gallery/">Open the archive <span class="arr" aria-hidden="true">→</span></a></div>
        </div>
      </div>
      <div class="mosaic">
        {mosaic.map((im: any) => <a href={`/${im.g.slug}/`}><img src={media(im.src, 's')} alt={im.g.title} loading="lazy" /><span class="meta">{im.g.title}</span></a>)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section inverse">
    <div class="wrap">
      <div class="section-head">
        <p class="idx"><b>Participate</b></p>
        <div>
          <h2 class="h1">Participation is by invitation. <em style="color:var(--green-300)">Your voice is welcome.</em></h2>
          <p class="lead" style="margin-top:24px">Write to us to take part in a summit, propose a speaker, partner with IASC or support the mission.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={`mailto:${SITE.email}`}>{SITE.email}</a>
            <a class="btn btn-secondary" href="/donate/">Support the mission</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding: clamp(40px, 5vw, 72px) 0 clamp(16px, 3vw, 40px); }
  .hero-meta { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0 0 clamp(40px, 6vw, 88px); border-top: 1px solid var(--color-line-strong); }
  .hero-meta div { padding: 12px 16px 0 0; }
  .hero-meta div + div { padding-left: 16px; border-left: 1px solid var(--color-line); }
  .hero-meta dt { font: 500 var(--size-12)/1.4 var(--font-meta); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-fg-muted); }
  .hero-meta dd { margin: 4px 0 0; font-size: var(--size-15); }
  .hero-title { max-width: 14ch; }
  .hero-sub { display: grid; grid-template-columns: 3fr 9fr; gap: var(--space-5); margin-top: clamp(32px, 4vw, 56px); }
  .hero-sub .lead { max-width: 52ch; }
  .hero-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-6); }
  .next { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .next-poster { display: block; border: 1px solid var(--color-line-strong); }
  .letter { display: grid; grid-template-columns: 3fr 9fr; gap: var(--space-5); align-items: start; }
  .letter-photo { margin: 0; position: sticky; top: calc(var(--header-h) + 32px); }
  .letter-photo img { width: 100%; max-width: 240px; aspect-ratio: 1; object-fit: cover; filter: grayscale(1); border-radius: 50%; }
  .letter-photo figcaption { display: flex; flex-direction: column; align-items: flex-start; margin-top: var(--space-4); }
  .letter .prose { max-width: 40em; }
  .theme-row .row-aside { max-width: 34ch; }
  .mosaic { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 220px; gap: var(--space-3); }
  .mosaic a { position: relative; overflow: hidden; background: var(--media-bg); display: flex; flex-direction: column; }
  .mosaic a:first-child { grid-column: span 2; grid-row: span 2; }
  .mosaic img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-slow) var(--ease); }
  .mosaic a:hover img { transform: scale(1.03); }
  .mosaic span { position: absolute; left: 0; bottom: 0; background: var(--color-bg); padding: 8px 10px; color: var(--color-fg); max-width: 90%; opacity: 0; transition: opacity var(--dur); }
  .mosaic a:hover span, .mosaic a:focus-visible span { opacity: 1; }
  @media (max-width: 960px) {
    .hero-meta { grid-template-columns: 1fr 1fr; }
    .hero-meta div:nth-child(odd) { border-left: 0 !important; padding-left: 0 !important; }
    .hero-meta div:nth-child(n+3) { border-top: 1px solid var(--color-line); margin-top: 12px; }
    .hero-sub, .next, .letter { grid-template-columns: 1fr; }
    .letter-photo { position: static; display: flex; gap: var(--space-4); align-items: center; }
    .letter-photo img { width: 96px; }
    .letter-photo figcaption { margin-top: 0; }
    .next-poster { max-width: 380px; }
    .mosaic { grid-template-columns: 1fr 1fr; grid-auto-rows: 150px; }
  }
</style>
