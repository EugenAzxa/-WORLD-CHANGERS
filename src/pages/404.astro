---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" noindex>
  <section class="page-hero" style="min-height:70vh;display:grid;align-items:center">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1 class="h1">This page has moved on.</h1>
      <p class="lead">Try the search, or start from one of these.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px">
        <button class="btn btn-gold" data-search-open>Search the site</button>
        <a class="btn btn-ghost" href="/">Home</a><a class="btn btn-ghost" href="/events-cat/">Events</a><a class="btn btn-ghost" href="/world-map/">World map</a>
      </div>
    </div>
  </section>
</Layout>
