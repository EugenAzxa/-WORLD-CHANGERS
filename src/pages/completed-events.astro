---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import EventsIndex from '../components/EventsIndex.astro';
import { completed } from '../lib/data';
---
<Layout title="Completed Events" description="Every World Changers gathering that has already taken place.">
  <PageHero title="Completed events" kicker={`${completed.length} gatherings`} lead="Reports, galleries, speakers and awards from every World Changers gathering." crumbs={[{ href: '/events-cat/', label: 'Events' }, { href: '/completed-events/', label: 'Completed' }]} />
  <section class="section" style="padding-top:0"><div class="wrap"><EventsIndex status="completed" /></div></section>
</Layout>
