---
import Layout from '../layouts/Layout.astro';
import Globe from '../components/Globe.astro';
import { stats } from '../lib/data';
---
<Layout title="World Map" description={`An interactive globe of every World Changers gathering: ${stats.events} events in ${stats.countries} countries.`}>
  <h1 class="sr-only">World Changers world map</h1>
  <Globe mode="full" />
</Layout>
