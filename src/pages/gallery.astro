---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { galleries, media, stats, fmtDate } from '../lib/data';
const list = [...galleries].sort((a, b) => (b.event?.start || b.date).localeCompare(a.event?.start || a.date));
---
<Layout title="Gallery" description={`${stats.photos} photos from World Changers summits around the world.`}>
  <PageHero title="Gallery" eyebrow={`${stats.photos.toLocaleString('en')} photos · ${galleries.length} albums`} lead="Moments from the Vatican, Davos, Dubai, Skopje, Tirana, Washington and beyond." crumbs={[{ href: '/gallery/', label: 'Gallery' }]} />
  <section class="section" style="padding-top:0"><div class="wrap">
    <div class="grid grid-3 stack-sm">
      {list.map((g) => (
        <a href={`/${g.slug}/`} class="card album">
          <div class="covers">{g.images.slice(0, 3).map((im: any) => <img src={media(im.src, 's')} alt="" loading="lazy" />)}</div>
          <div class="card-body">
            <div class="meta">{g.event ? g.event.dateRange : fmtDate(g.date)} · {g.images.length} photos</div>
            <h3>{g.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </div></section>
</Layout>
<style>
  .album .covers { display: grid; grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; gap: 2px; aspect-ratio: 16 / 11; background: var(--media-bg); overflow: hidden; }
  .album .covers img { width: 100%; height: 100%; object-fit: cover; }
  .album .covers img:first-child { grid-row: span 2; }
  .album h3 { font: 400 var(--size-24)/1.2 var(--font-display); margin-top: 8px; }
</style>
