---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import VenuesIndex from '../components/VenuesIndex.astro';
import { locations } from '../lib/data';
---
<Layout title="Venues" description="The palaces, academies, basilicas and cities that have hosted World Changers.">
  <PageHero title="Venues" kicker={`${locations.length} places`} lead="From the Casina Pio IV in the Vatican Gardens to the castle of Porto Palermo — the extraordinary places that host World Changers." crumbs={[{ href: '/events-cat/', label: 'Events' }, { href: '/locations/', label: 'Venues' }]}>
    <div style="margin-top:28px"><a href="/world-map/" class="btn btn-gold">Open the world map <span class="arr">→</span></a></div>
  </PageHero>
  <section class="section" style="padding-top:0"><div class="wrap"><VenuesIndex /></div></section>
</Layout>
